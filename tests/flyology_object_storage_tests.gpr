with "config/flyology_object_storage_tests_config.gpr";
with "aunit";
with "flyology_object_storage";
project Flyology_Object_Storage_Tests is

   for Source_Dirs use ("src/", "config/");
   for Object_Dir use "obj/" & Flyology_Object_Storage_Tests_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Exec_Dir use "bin";
   for Main use
     ("flyology_object_storage_tests.adb",
      "files_conditional_symlink_probe.adb",
      "files_crash_probe.adb",
      "files_open_probe.adb",
      "s3_bucket_tagging_benchmark.adb",
      "files_copy_benchmark.adb",
      "s3_checksum_benchmark.adb",
      "s3_multipart_checksum_benchmark.adb",
      "s3_checksum_corpus.adb",
      "s3_multipart_listing_benchmark.adb",
      "s3_files_server.adb",
      "s3_http_socket_corpus.adb",
      "s3_list_object_versions_corpus.adb",
      "s3_delete_bucket_cors_corpus.adb",
      "s3_delete_bucket_configurations_corpus.adb",
      "s3_get_bucket_controls_corpus.adb",
      "s3_put_bucket_controls_corpus.adb",
      "s3_put_bucket_ownership_controls_corpus.adb",
      "s3_create_bucket_metadata_table_configuration_corpus.adb",
      "s3_delete_object_annotation_corpus.adb",
      "s3_put_object_legal_hold_corpus.adb",
      "s3_put_object_retention_corpus.adb",
      "s3_put_object_lock_configuration_corpus.adb",
      "s3_get_object_torrent_corpus.adb",
      "s3_get_object_torrent_socket_corpus.adb",
      "s3_get_object_legal_hold_corpus.adb",
      "s3_get_object_retention_corpus.adb",
      "s3_get_object_lock_configuration_corpus.adb",
      "s3_get_bucket_ownership_controls_corpus.adb",
      "s3_get_bucket_cors_corpus.adb",
      "s3_get_bucket_encryption_corpus.adb",
      "s3_get_bucket_lifecycle_configuration_corpus.adb",
      "s3_put_bucket_lifecycle_configuration_corpus.adb",
      "s3_bucket_notification_configuration_corpus.adb",
      "s3_get_bucket_replication_corpus.adb",
      "s3_get_bucket_replication_qualification.adb",
      "s3_get_bucket_metrics_configuration_qualification.adb",
      "s3_list_bucket_metrics_configurations_qualification.adb",
      "s3_list_bucket_analytics_configurations_qualification.adb",
      "s3_list_bucket_intelligent_tiering_configurations_qualification.adb",
      "s3_list_bucket_inventory_configurations_qualification.adb",
      "s3_list_object_annotations_qualification.adb",
      "s3_get_bucket_analytics_configuration_qualification.adb",
      "s3_get_bucket_intelligent_tiering_configuration_qualification.adb",
      "s3_get_bucket_inventory_configuration_qualification.adb",
      "s3_get_bucket_logging_qualification.adb",
      "s3_get_bucket_metadata_configuration_qualification.adb",
      "s3_get_bucket_website_qualification.adb",
      "s3_put_bucket_replication_corpus.adb",
      "s3_get_bucket_metadata_table_configuration_corpus.adb",
      "s3_get_bucket_acl_corpus.adb",
      "s3_get_object_acl_corpus.adb",
      "s3_create_session_tls_corpus.adb",
      "s3_transfer_many_corpus.adb",
      "s3_implementation_corpus.adb",
      "s3_memory_server.adb",
      "s3_server_application_corpus.adb");

   package Compiler is
      for Default_Switches ("Ada") use
        Flyology_Object_Storage_Tests_Config.Ada_Compiler_Switches
        & ("-gnat2022", "-gnatwa", "-gnatwe", "-gnatwJ");
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es"); --  Symbolic traceback
   end Binder;

   package Install is
      for Artifacts (".") use ("share");
   end Install;

end Flyology_Object_Storage_Tests;
