with "flyology.gpr";

project Flyology_Object_Storage_Proof is
   for Languages use ("Ada");
   for Source_Dirs use ("../src");
   for Object_Dir use "../obj/proof";
   for Create_Missing_Dirs use "True";

   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022",
         "-gnatwa",
         "-gnatw.X",
         "-gnatVa",
         "-gnatW8");
   end Compiler;
end Flyology_Object_Storage_Proof;
