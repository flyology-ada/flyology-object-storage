           (Response, Flyology.Bytes.To_Byte_String (Payload), Prepared,
            Limits);
      end;
   exception
      when Flyology.HTTP.Client.Response_Too_Large =>
         raise Invalid_Response with "PutObject response body exceeds limit";
   end Execute_Put_Object;

