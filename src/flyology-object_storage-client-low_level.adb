   function Decode_Complete_Multipart_Complete_Response
     (Response : Flyology.HTTP.Client.Response;
      Payload  : String;
      Prepared : Prepared_Request;
      Limits   : S3.XML.Parse_Limits := S3.XML.Default_Limits)
      return Complete_Multipart_Outcome
   is
