         for Index in 1 .. Flyology.HTTP.Client.Header_Count (Response) loop
            declare
               Name : constant String := Ada.Characters.Handling.To_Lower
                 (Flyology.HTTP.Client.Header_Name (Response, Index));
               Prefix : constant String := "x-amz-meta-";
