                 "invalid CompleteMultipartUpload response header";
            end if;
            for Character_Value of Value loop
               if Character'Pos (Character_Value) < 32
                 or else Character'Pos (Character_Value) = 127
               then
                  raise Invalid_Response with
                    "invalid CompleteMultipartUpload response header";
               end if;
            end loop;
            return Value;
