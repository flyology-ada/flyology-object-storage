           Flyology.HTTP.Client.Execute
             (Client, Prepared.Message, Timeout, Token);

         function Singleton_Header (Name : String) return String is
            Count : constant Natural :=
              Flyology.HTTP.Client.Header_Count (Response, Name);
         begin
