      Host_ID : constant String := Singleton_Header ("x-amz-id-2");
      Bucket_Key : constant String := Singleton_Header
        ("x-amz-server-side-encryption-bucket-key-enabled");
      Headers : constant Complete_Multipart_Response_Headers :=
