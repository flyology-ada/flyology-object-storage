   function Whitespace_Only (Value : String) return Boolean is
   begin
      for Item of Value loop
         if Item /= ' '
           and then Item /= Character'Val (9)
           and then Item /= Character'Val (10)
           and then Item /= Character'Val (13)
         then
            return False;
         end if;
      end loop;
      return True;
   end Whitespace_Only;

