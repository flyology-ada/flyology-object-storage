   begin
      return
        (Kind        => List_Buckets_Exchange_Failed,
         Failure     => Failed_Reason (Kind),
         Admission   => Admission,
         HTTP_Result => Kind,
         HTTP_Phase  => Phase,
         Detail      => US.To_Unbounded_String (Detail));
