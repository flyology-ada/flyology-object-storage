with "config/flyology_object_storage_sqlite_config.gpr";
with "flyology_object_storage";
project Flyology_Object_Storage_Sqlite is

   for Library_Name use "Flyology_Object_Storage_Sqlite";
   for Library_Version use Project'Library_Name & ".so." & Flyology_Object_Storage_Sqlite_Config.Crate_Version;

   for Languages use ("Ada", "C");
   for Source_Dirs use ("src/", "config/", "vendor/sqlite/");
   for Object_Dir use "obj/" & Flyology_Object_Storage_Sqlite_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Library_Dir use "lib";

   type Library_Type_Type is ("relocatable", "static", "static-pic");
   Library_Type : Library_Type_Type :=
     external ("FLYOLOGY_OBJECT_STORAGE_SQLITE_LIBRARY_TYPE", external ("LIBRARY_TYPE", "static"));
   for Library_Kind use Library_Type;

   package Compiler is
      for Default_Switches ("Ada") use Flyology_Object_Storage_Sqlite_Config.Ada_Compiler_Switches;
      for Default_Switches ("C") use
        ("-O2",
         "-fPIC",
         "-DSQLITE_THREADSAFE=1",
         "-DSQLITE_DQS=0",
         "-DSQLITE_DEFAULT_MEMSTATUS=0",
         "-DSQLITE_OMIT_DEPRECATED",
         "-DSQLITE_ENABLE_API_ARMOR",
         "-DSQLITE_ENABLE_COLUMN_METADATA",
         "-DSQLITE_ENABLE_DBSTAT_VTAB",
         "-DSQLITE_ENABLE_FTS5",
         "-DSQLITE_ENABLE_RTREE",
         "-DSQLITE_USE_URI=1");
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es"); --  Symbolic traceback
   end Binder;

   package Install is
      for Artifacts (".") use ("share");
   end Install;

end Flyology_Object_Storage_Sqlite;
