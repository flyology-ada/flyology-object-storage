with "config/flyology_object_storage_sqlite_tests_config.gpr";
with "flyology_object_storage_sqlite";
project Flyology_Object_Storage_Sqlite_Tests is

   for Source_Dirs use ("src/", "config/", "../../tests/src/");
   for Object_Dir use "obj/" & Flyology_Object_Storage_Sqlite_Tests_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Exec_Dir use "bin";
   for Main use
     ("flyology_object_storage_sqlite_tests.adb",
      "s3_sqlite_server.adb");

   package Compiler is
      for Default_Switches ("Ada") use
        Flyology_Object_Storage_Sqlite_Tests_Config.Ada_Compiler_Switches
        & ("-gnat2022", "-gnatwa", "-gnatwe", "-gnatwJ");
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es"); --  Symbolic traceback
   end Binder;

   package Install is
      for Artifacts (".") use ("share");
   end Install;

end Flyology_Object_Storage_Sqlite_Tests;
