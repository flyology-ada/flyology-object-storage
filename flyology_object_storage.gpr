with "flyology_http.gpr";
with "xmlada_input.gpr";
with "xmlada_sax.gpr";
with "config/flyology_object_storage_config.gpr";
project Flyology_Object_Storage is

   for Languages use ("Ada", "C");
   for Library_Name use "Flyology_Object_Storage";
   for Library_Version use Project'Library_Name & ".so." & Flyology_Object_Storage_Config.Crate_Version;

   for Source_Dirs use ("src/", "config/");
   for Object_Dir use "obj/" & Flyology_Object_Storage_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Library_Dir use "lib";

   type Library_Type_Type is ("relocatable", "static", "static-pic");
   Library_Type : Library_Type_Type :=
     external ("FLYOLOGY_OBJECT_STORAGE_LIBRARY_TYPE", external ("LIBRARY_TYPE", "static"));
   for Library_Kind use Library_Type;

   package Compiler is
      for Default_Switches ("Ada") use
        Flyology_Object_Storage_Config.Ada_Compiler_Switches
        & ("-gnatwJ");
      for Default_Switches ("C") use
        ("-std=c11", "-O2", "-fPIC", "-Wall", "-Wextra", "-Wconversion",
         "-Werror");
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es"); --  Symbolic traceback
   end Binder;

   package Install is
      for Artifacts (".") use ("share");
   end Install;

   package Documentation is
      --  The public API report belongs to this crate; dependency APIs have
      --  their own documentation gates and would obscure local warnings.
      for Excluded_Project_Files use
        (external ("FLYOLOGY_HTTP_ALIRE_PREFIX", "")
         & "/flyology_http.gpr",
         external ("FLYOLOGY_ROOT", "") & "/flyology.gpr",
         external ("FLYOLOGY_CACHELINES_ALIRE_PREFIX", "")
         & "/flyology_cachelines.gpr",
         external ("FLYOLOGY_QUIC_ALIRE_PREFIX", "")
         & "/flyology_quic.gpr",
         external ("XMLADA_ALIRE_PREFIX", "")
         & "/input_sources/xmlada_input.gpr",
         external ("XMLADA_ALIRE_PREFIX", "")
         & "/sax/xmlada_sax.gpr",
         external ("XMLADA_ALIRE_PREFIX", "")
         & "/unicode/xmlada_unicode.gpr",
         external ("XMLADA_ALIRE_PREFIX", "")
         & "/dom/xmlada_dom.gpr",
         external ("XMLADA_ALIRE_PREFIX", "")
         & "/schema/xmlada_schema.gpr",
         external ("XMLADA_ALIRE_PREFIX", "")
         & "/xmlada_shared.gpr",
         "config/flyology_object_storage_config.gpr");
   end Documentation;

end Flyology_Object_Storage;
